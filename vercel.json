{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/ssr.js": {
      "includeFiles": "{src/views/**,src/data/**}",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/ssr?__path=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/ssr?__path=/sitemap.xml"
    },
    {
      "source": "/sitemaps/:file",
      "destination": "/api/ssr?__path=/sitemaps/:file"
    },
    {
      "source": "/((?!api/|.*\\.[\\w]+$).*)",
      "destination": "/api/ssr?__path=/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/hls.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ]
}
